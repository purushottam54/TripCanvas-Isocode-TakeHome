# TripCanvas Environment Configuration
# Copy this file to .env.local and fill in your credentials

# Supabase PostgreSQL & Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Site URL for canonical URLs and absolute links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Gemini API Key (Server-side only, never expose to browser)
GEMINI_API_KEY=your-gemini-api-key-here
